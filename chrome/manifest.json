{
  "manifest_version": 3,
  "name": "NEXUS Playback Bar",
  "version": "0.2.35",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Connect this tab to the NEXUS",
    "default_icon": {
      "16": "icons/npb-16.png",
      "24": "icons/npb-24.png",
      "32": "icons/npb-32.png"
    }
  },
  "host_permissions": [
    "http://127.0.0.1:18763/*",
    "https://*.media-amazon.com/*",
    "https://*.ssl-images-amazon.com/*",
    "https://images.amazon.com/*"
  ],
  "background": {
    "service_worker": "bridge.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "player.js"
      ],
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/npb-16.png",
    "24": "icons/npb-24.png",
    "32": "icons/npb-32.png",
    "48": "icons/npb-48.png",
    "128": "icons/npb-128.png"
  }
}
